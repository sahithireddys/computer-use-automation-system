{
  "schema_version": "1.0",
  "capability_id": "open-sub-account",
  "name": "Open Sub Account",
  "description": "Open a new sub-account (Savings/Checking/Money Market) for an existing member, with an initial deposit, subject to the target app's own confirmation step. IRREVERSIBLE.",
